# ─── Inflexion dApp (apps/web) — copy to .env.local and fill in ───

# Arbitrum Sepolia RPC the dApp reads from. Falls back to the chain's public RPC
# if unset (rate-limited — set your own Alchemy/Infura/etc. for a smooth demo).
NEXT_PUBLIC_RPC_URL=

# WalletConnect Cloud project id (RainbowKit). Get one free at
# https://cloud.walletconnect.com — without it WalletConnect is non-functional
# (injected wallets like MetaMask still work).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Path-B engine (relayer) base URL — `pnpm --filter @inflexion/engine dev` serves
# http://localhost:8787. Unset → Path-B quotes unavailable and premium falls back
# to Path A (the pool); the app still works end-to-end on Path A.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8787

# Public REST API base URL (optional). The dApp reads live data via the SDK
# directly; the API is for external consumers + the (subgraph-backed) history.
NEXT_PUBLIC_API_URL=http://localhost:8088
