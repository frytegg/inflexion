# ─────────────────────────────────────────────────────────────────────────────
# Inflexion — single environment source of truth (monorepo root).
#
# Copy to `.env` and fill in. The Node services read THIS file:
#   • @inflexion/api      → `pnpm --filter @inflexion/api start` loads ../../.env
#   • @inflexion/engine   → reads process env (set these in your shell or host)
#   • contracts scripts   → forge/cast read the shell env
#
# ONE exception: the Next.js dApp (apps/web). Next only auto-loads env from its
# own directory, so copy the NEXT_PUBLIC_* block at the bottom into
# apps/web/.env.local. (That is the only other env file in the repo.)
#
# On a host (Railway/Fly/Vercel) set these as platform env vars instead of a file.
# NEVER commit real private keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC endpoints ──
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc   # alias; @inflexion/api falls back to this
LOCAL_RPC=http://localhost:8545

# ── Contracts: keys & verification (never mainnet keys) ──
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# ── Subgraph (The Graph Studio) ──
THEGRAPH_DEPLOY_KEY=
# Deployed subgraph query endpoint, consumed by @inflexion/api. `version/latest`
# auto-resolves to the live version once the Studio deploy registers.
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1754692/inflexion-arb-sepolia/version/latest

# ── Engine (Path-B relayer, @inflexion/engine) ──
ENGINE_PORT=8787
REDIS_URL=redis://localhost:6379

# ── REST API (@inflexion/api) ──
PORT=8088
# Engine telemetry sinks (read-only JSONL): Signal 4 (latent demand) + Signal 2 (quote competition).
DEMAND_LOG=
COMPETITION_LOG=

# ── Frontend (apps/web) — COPY THIS BLOCK into apps/web/.env.local ──
# (Next.js only loads env from its own directory, so these can't live only here.)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ENGINE_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8088
