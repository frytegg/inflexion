{
  "name": "@inflexion/subgraph",
  "version": "0.0.0",
  "private": true,
  "description": "@inflexion/subgraph — The Graph indexer that reconstructs Inflexion on-chain EVENT history into the queryable store feeding the public API (the five data-moat signals). Manifest is templated from deployments/arbitrum-sepolia.json and regenerated at the single redeploy (the moat dataset begins there).",
  "scripts": {
    "prepare:manifest": "node scripts/gen-manifest.mjs",
    "codegen": "graph codegen",
    "build": "graph codegen",
    "build:wasm": "graph codegen && graph build",
    "create:local": "graph create --node http://localhost:8020/ inflexion/inflexion",
    "deploy:local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 inflexion/inflexion",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ inflexion-arb-sepolia",
    "clean": "node -e \"require('node:fs').rmSync('generated',{recursive:true,force:true}); require('node:fs').rmSync('build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.71.2",
    "@graphprotocol/graph-ts": "0.35.1"
  }
}
