{
  "name": "@inflexion/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inflexion off-chain Path-B quote relayer (thin, single-MM) + shared EIP-712 quote helpers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./quote": "./dist/quote.js",
    "./server": "./dist/server.js",
    "./addresses": "./dist/addresses.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mm-bot": "tsx src/mm-bot.ts",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "viem": "^2.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
